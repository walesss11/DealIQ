// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  }

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String?
  image               String?
  passwordHash        String?              @map("password_hash")
  emailVerified       DateTime?            @map("email_verified")
  onboardingCompleted Boolean              @default(false) @map("onboarding_completed")
  userRole            String?              @map("user_role")
  role                String               @default("USER") // USER | ADMIN | SUPER_ADMIN
  freeReviewUsed      Boolean              @default(false) @map("free_review_used")
  contractTypes       String?              @map("contract_types") @db.Text // JSON string array
  priorities          String?              @map("priorities") @db.Text // JSON string array
  contractExperience  String?              @map("contract_experience")
  onboardingStep      Int                  @default(1) @map("onboarding_step")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at")
  contracts           Contract[]
  payments            Payment[]
  conversations       Conversation[]
  accounts            Account[]
  sessions            Session[]

  @@map("users")
}

model Account {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  type              String   @default("oauth")
  provider          String
  providerAccountId String   @map("provider_account_id")
  refreshToken      String?  @map("refresh_token") @db.Text
  accessToken       String?  @map("access_token") @db.Text
  expiresAt         Int?     @map("expires_at")
  tokenType         String?  @map("token_type")
  scope             String?
  idToken           String?  @map("id_token") @db.Text
  sessionState      String?  @map("session_state")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("password_reset_tokens")
}

model Contract {
  id           String            @id @default(cuid())
  userId       String?           @map("user_id")
  filename     String
  contractType String?           @map("contract_type")
  status       String            @default("pending") // pending | processing | complete | error
  createdAt    DateTime          @default(now()) @map("created_at")
  user         User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions     ContractVersion[]
  conversations Conversation[]

  @@map("contracts")
  @@index([userId])
}

model ContractVersion {
  id            String    @id @default(cuid())
  contractId    String    @map("contract_id")
  versionNumber Int       @map("version_number") @default(1)
  filename      String?
  fileReference String    @map("file_reference") // Supabase Storage path
  extractedText String?   @map("extracted_text") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  contract      Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  clauses       Clause[]
  reviews       Review[]

  @@map("contract_versions")
  @@unique([contractId, versionNumber])
}

model Clause {
  id                String          @id @default(cuid())
  contractVersionId String          @map("contract_version_id")
  title             String?
  section           String?
  text              String          @db.Text
  pageNumber        Int?            @map("page_number")
  position          Int             @default(0) // ordinal position in document
  clauseType        String?         @map("clause_type")
  contractVersion   ContractVersion @relation(fields: [contractVersionId], references: [id], onDelete: Cascade)
  findings          Finding[]

  @@map("clauses")
  @@unique([contractVersionId, position])
}

model Review {
  id                String          @id @default(cuid())
  contractVersionId String          @map("contract_version_id")
  status            String          @default("pending") // pending | running | complete | error
  overallAttention  String?         @map("overall_attention") // JSON summary counts
  modelVersion      String?         @map("model_version")
  classificationResult String?      @map("classification_result") @db.Text // JSON
  comparisonResult  String?         @map("comparison_result") @db.Text // JSON comparison against previous version
  userRole          String?         @map("user_role")
  userContractType  String?         @map("user_contract_type")
  userPriorities    String?         @map("user_priorities") // JSON array
  isPaid            Boolean         @default(false) @map("is_paid")
  isFreeTrial       Boolean         @default(false) @map("is_free_trial")
  createdAt         DateTime        @default(now()) @map("created_at")
  completedAt       DateTime?       @map("completed_at")
  contractVersion   ContractVersion @relation(fields: [contractVersionId], references: [id], onDelete: Cascade)
  findings          Finding[]
  payments          Payment[]
  conversations     Conversation[]

  // Immutability: Reviews are never updated after creation (except status/completedAt)
  // A re-run creates a NEW Review linked to the same ContractVersion.
  @@map("reviews")
  @@index([contractVersionId, createdAt])
}

model Finding {
  id               String   @id @default(cuid())
  reviewId         String   @map("review_id")
  clauseId         String   @map("clause_id")
  category         String   // payment | deliverables | content_rights | exclusivity | termination | liability | image_likeness | general
  severity         String   // high | worth_reviewing | understand | no_issue
  title            String
  // Three-layer format (spec Section 7.2)
  whatItSays       String   @map("what_it_says") @db.Text // Layer 1: factual restatement
  whatItMeans      String   @map("what_it_means") @db.Text // Layer 2: plain-language meaning
  whatToConsider   String   @map("what_to_consider") @db.Text // Layer 3: actionable suggestion
  // Source validation (spec Section 6)
  sourceValidated  Boolean  @default(false) @map("source_validated")
  confidence       Float?   // 0.0-1.0
  rejectionReason  String?  @map("rejection_reason") @db.Text
  // Negotiation options & suggested alternative wording (spec Section 7.4)
  negotiationOptions String?  @map("negotiation_options") @db.Text // JSON array of options
  suggestedRewrite   String?  @map("suggested_rewrite") @db.Text
  emailSnippet       String?  @map("email_snippet") @db.Text
  // Cross-clause linkage (spec Section 5.1)
  isCrossClause      Boolean  @default(false) @map("is_cross_clause")
  relatedClauseIds   String?  @map("related_clause_ids") @db.Text // JSON array
  createdAt        DateTime @default(now()) @map("created_at")
  review           Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  clause           Clause   @relation(fields: [clauseId], references: [id], onDelete: Cascade)

  @@map("findings")
  @@index([reviewId, sourceValidated])
  @@index([clauseId])
}

model Payment {
  id                  String    @id @default(cuid())
  userId              String    @map("user_id")
  reviewId            String    @map("review_id")
  amount              Float
  currency            String    @default("NGN")
  provider            String    @default("paystack") // paystack | stripe
  status              String    @default("pending") // pending | paid | failed | abandoned
  transactionReference String?  @unique @map("transaction_reference")
  paidAt              DateTime? @map("paid_at")
  metadata            String?   @db.Text
  createdAt           DateTime  @default(now()) @map("created_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  review              Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("payments")
  @@index([userId])
  @@index([reviewId])
  @@index([transactionReference])
}

model Conversation {
  id          String        @id @default(cuid())
  contractId  String        @map("contract_id")
  reviewId    String?       @map("review_id")
  userId      String?       @map("user_id")
  title       String?
  summary     String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  contract    Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  review      Review?       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]

  @@map("conversations")
  @@index([contractId])
  @@index([reviewId])
  @@index([userId])
}

model ChatMessage {
  id                String       @id @default(cuid())
  conversationId    String       @map("conversation_id")
  role              String       // user | assistant
  content           String       @db.Text
  focusContext      String?      @map("focus_context") @db.Text // JSON: { type, findingId, clauseId, label }
  sources           String?      @db.Text // JSON: Array<{ sectionOrTitle, quoteSnippet }>
  negotiationAction String?      @map("negotiation_action") @db.Text // JSON: { title, draftEmail, replacementClause }
  createdAt         DateTime     @default(now()) @map("created_at")
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
  @@index([conversationId, createdAt])
}

model AdminAuditLog {
  id               String   @id @default(cuid())
  adminId          String   @map("admin_id")
  adminEmail       String   @map("admin_email")
  action           String   // e.g. "PROMOTE_ADMIN", "REVOKE_ADMIN", "RERUN_PIPELINE"
  targetUserId     String?  @map("target_user_id")
  targetUserEmail  String?  @map("target_user_email")
  details          String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("admin_audit_logs")
  @@index([adminId])
  @@index([createdAt])
}

